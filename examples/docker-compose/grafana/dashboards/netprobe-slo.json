{
  "uid": "netprobe-slo",
  "title": "netprobe - availability and loss budget",
  "description": "Availability, downtime and loss aggregated over the selected time range, measured against a target objective. Source: netprobe-exporter.",
  "tags": ["netprobe", "network", "slo"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "scope",
        "label": "Scope",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(netprobe_probe_success, scope)",
        "query": {
          "qryType": 1,
          "query": "label_values(netprobe_probe_success, scope)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [],
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "target",
        "label": "Target",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(netprobe_probe_success{scope=~\"$scope\"}, name)",
        "query": {
          "qryType": 1,
          "query": "label_values(netprobe_probe_success{scope=~\"$scope\"}, name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [],
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "proto",
        "label": "Protocol",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(netprobe_probe_success, proto)",
        "query": {
          "qryType": 1,
          "query": "label_values(netprobe_probe_success, proto)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [],
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "slo",
        "label": "Objective (%)",
        "type": "textbox",
        "description": "Availability objective the panels are scored against.",
        "query": "99.9",
        "current": { "text": "99.9", "value": "99.9" },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Over the selected range",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "Fleet availability",
      "description": "Share of scrapes where the probe had received at least one reply, averaged over every selected probe and the whole range. The colour thresholds are fixed at 99% and 99.9%; the Objective variable drives the budget columns below, not these.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg(avg_over_time(netprobe_probe_success{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__range]))",
          "instant": true,
          "legendFormat": "availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0.9,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#fab219", "value": 0.99 },
              { "color": "#0ca30c", "value": 0.999 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "sizing": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Probes below objective",
      "description": "How many of the selected probes failed to reach the objective over the range.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(avg_over_time(netprobe_probe_success{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__range]) < bool ${slo:raw} / 100 == 1) or vector(0)",
          "instant": true,
          "legendFormat": "below objective"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 1 },
              { "color": "#d03b3b", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Worst downtime",
      "description": "Downtime of the least available probe, derived from the share of scrapes it spent down multiplied by the length of the range.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(1 - avg_over_time(netprobe_probe_success{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__range])) * $__range_s",
          "instant": true,
          "legendFormat": "worst downtime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 60 },
              { "color": "#d03b3b", "value": 600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Packet loss over the range",
      "description": "1 - received/sent across every selected probe for the whole range. Computed from the counters, so it is independent of the probe interval.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - sum(increase(netprobe_packets_received_total{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__range])) / sum(increase(netprobe_packets_sent_total{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__range]))",
          "instant": true,
          "legendFormat": "loss"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 0.01 },
              { "color": "#ec835a", "value": 0.02 },
              { "color": "#d03b3b", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Per probe",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "table",
      "title": "Scoreboard",
      "description": "One row per target and protocol over the selected range, worst availability first. Budget left is the fraction of the allowed downtime that is still unspent; it turns negative once the objective has been missed.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 12, "w": 15, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg_over_time(netprobe_probe_success{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__range])",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(1 - avg_over_time(netprobe_probe_success{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__range])) * $__range_s",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - increase(netprobe_packets_received_total{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__range]) / increase(netprobe_packets_sent_total{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__range])",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - (1 - avg_over_time(netprobe_probe_success{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__range])) / (1 - ${slo:raw} / 100)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg_over_time(netprobe_rtt_seconds{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__range])",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "host": true,
              "provider": true
            },
            "indexByName": {
              "name": 0,
              "proto": 1,
              "port": 2,
              "scope": 3,
              "Value #A": 4,
              "Value #D": 5,
              "Value #B": 6,
              "Value #C": 7,
              "Value #E": 8
            },
            "renameByName": {
              "name": "Target",
              "proto": "Proto",
              "port": "Port",
              "scope": "Scope",
              "Value #A": "Availability",
              "Value #B": "Downtime",
              "Value #C": "Loss",
              "Value #D": "Budget left",
              "Value #E": "Mean RTT"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Proto" },
            "properties": [
              { "id": "custom.width", "value": 76 },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "icmp": { "text": "icmp", "color": "#3987e5", "index": 0 },
                      "tcp": { "text": "tcp", "color": "#d95926", "index": 1 },
                      "udp": { "text": "udp", "color": "#199e70", "index": 2 }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Availability" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 3 },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#d03b3b", "value": null },
                    { "color": "#fab219", "value": 0.99 },
                    { "color": "#0ca30c", "value": 0.999 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Budget left" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 0 },
              { "id": "max", "value": 1 },
              { "id": "min", "value": -1 },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#d03b3b", "value": null },
                    { "color": "#fab219", "value": 0 },
                    { "color": "#0ca30c", "value": 0.5 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "basic" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Downtime" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Loss" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 3 },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#0ca30c", "value": null },
                    { "color": "#fab219", "value": 0.01 },
                    { "color": "#ec835a", "value": 0.02 },
                    { "color": "#d03b3b", "value": 0.05 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Mean RTT" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 1 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" },
        "sortBy": [{ "displayName": "Availability", "desc": false }]
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Availability by target",
      "description": "Availability over the range, least available first. The scale starts at 90% so the interesting part of the range is not compressed into the last pixel.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 12, "w": 9, "x": 15, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sort(avg by (name, proto) (avg_over_time(netprobe_probe_success{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__range])))",
          "instant": true,
          "legendFormat": "{{name}} / {{proto}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0.9,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#fab219", "value": 0.99 },
              { "color": "#0ca30c", "value": 0.999 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16,
        "maxVizHeight": 300
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Trend",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Rolling availability (1h)",
      "description": "Availability computed over a trailing hour. The dashed line marks 99.9%; anything dipping below it is spending budget.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg by (name, proto) (avg_over_time(netprobe_probe_success{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[1h]))",
          "legendFormat": "{{name}} / {{proto}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "color": { "mode": "palette-classic-by-name" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#fab219", "value": null },
              { "color": "transparent", "value": 0.999 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisSoftMin": 0.9,
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "insertNulls": false,
            "thresholdsStyle": { "mode": "dashed" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": ["min", "mean"]
        },
        "tooltip": { "mode": "multi", "sort": "asc", "maxHeight": 600 }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Downtime per hour",
      "description": "Seconds spent down in each hour, stacked across probes. Useful for spotting a recurring window.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (name) ((1 - avg_over_time(netprobe_probe_success{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[1h])) * 3600)",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 0,
            "fillOpacity": 80,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisSoftMin": 0,
            "axisBorderShow": false,
            "barAlignment": 0,
            "scaleDistribution": { "type": "linear" },
            "insertNulls": false,
            "stacking": { "mode": "normal", "group": "A" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc", "maxHeight": 600 }
      }
    }
  ]
}
