{
  "uid": "netprobe-timeline",
  "title": "netprobe - status timeline",
  "description": "When each probe was up or down, how often it flapped, and how latency was distributed while it was up. Built for looking backwards at an incident rather than at the current value. Source: netprobe-exporter.",
  "tags": ["netprobe", "network", "incident"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "scope",
        "label": "Scope",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(netprobe_probe_success, scope)",
        "query": {
          "qryType": 1,
          "query": "label_values(netprobe_probe_success, scope)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [],
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "target",
        "label": "Target",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(netprobe_probe_success{scope=~\"$scope\"}, name)",
        "query": {
          "qryType": 1,
          "query": "label_values(netprobe_probe_success{scope=~\"$scope\"}, name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [],
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "proto",
        "label": "Protocol",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(netprobe_probe_success, proto)",
        "query": {
          "qryType": 1,
          "query": "label_values(netprobe_probe_success, proto)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [],
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "State over time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Up and down",
      "description": "One lane per target and protocol. Each band is a stretch of scrapes with the same result, so a narrow red sliver is a single failed cycle and a wide one is a real outage.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "netprobe_probe_success{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}",
          "legendFormat": "{{name}} / {{proto}}{{port}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "up", "color": "#0ca30c", "index": 0 },
                "0": { "text": "down", "color": "#d03b3b", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#0ca30c", "value": 1 }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "spanNulls": false,
            "insertNulls": false,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.85,
        "perPage": 20,
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none", "maxHeight": 600 }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Instability",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Flaps over the range",
      "description": "Number of times the probe changed state in the selected range. A target that flaps twenty times is a different problem from one that went down once and stayed down, even though both can show the same availability.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sort_desc(changes(netprobe_probe_success{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{name}} / {{proto}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 2 },
              { "color": "#ec835a", "value": 6 },
              { "color": "#d03b3b", "value": 12 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16,
        "maxVizHeight": 300
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Probes down",
      "description": "How many of the selected probes were failing at each point in time. A single spike across many probes at once is usually the vantage point, not the targets.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 16, "x": 8, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(1 - netprobe_probe_success{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"})",
          "legendFormat": "down"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(netprobe_probe_success{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"})",
          "legendFormat": "total probes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisSoftMin": 0,
            "axisSoftMax": 2,
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "insertNulls": false,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "down" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }]
          },
          {
            "matcher": { "id": "byName", "options": "total probes" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#898781" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc", "maxHeight": 600 }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Latency while up",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "heatmap",
      "title": "Round-trip time distribution",
      "description": "Every selected probe's mean round-trip time, bucketed. Watch for the band widening or a second band appearing before an outage: degradation usually shows here before the state timeline turns red.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "netprobe_rtt_seconds{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}",
          "legendFormat": "{{name}} / {{proto}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": {} }, "overrides": [] },
      "options": {
        "calculate": true,
        "calculation": { "yBuckets": { "mode": "size", "scale": { "type": "linear" } } },
        "color": {
          "mode": "scheme",
          "scheme": "Blues",
          "steps": 32,
          "reverse": false,
          "exponent": 0.5,
          "fill": "#3987e5"
        },
        "cellGap": 1,
        "cellValues": { "unit": "short" },
        "yAxis": { "axisPlacement": "left", "unit": "s", "reverse": false },
        "legend": { "show": true },
        "tooltip": { "mode": "single", "yHistogram": true, "showColorScale": true },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "filterValues": { "le": 1e-9 },
        "rowsFrame": { "layout": "auto" },
        "showValue": "never"
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Loss severity",
      "description": "Packet loss over the rolling window, bucketed into four bands so a long range stays readable where a line chart would not.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - rate(netprobe_packets_received_total{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__rate_interval]) / rate(netprobe_packets_sent_total{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__rate_interval])",
          "legendFormat": "{{name}} / {{proto}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 0.01 },
              { "color": "#ec835a", "value": 0.05 },
              { "color": "#d03b3b", "value": 0.25 }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "spanNulls": false,
            "insertNulls": false,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": false,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.85,
        "perPage": 20,
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none", "maxHeight": 600 }
      }
    }
  ]
}
