{
  "uid": "netprobe-voice",
  "title": "netprobe - voice quality and latency distribution",
  "description": "Whether the line can hold a call, and what the latency actually looks like rather than what its average says. The score comes from the simplified ITU-T G.107 E-model applied to the latency, jitter and loss already measured, so it costs no extra traffic; treat it as an indicator, since one-way delay is approximated as half the round trip. Source: netprobe-exporter.",
  "tags": ["netprobe", "network", "voice", "latency"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "scope",
        "label": "Scope",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(netprobe_probe_success, scope)",
        "query": {
          "qryType": 1,
          "query": "label_values(netprobe_probe_success, scope)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [],
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "target",
        "label": "Target",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(netprobe_probe_success{scope=~\"$scope\"}, name)",
        "query": {
          "qryType": 1,
          "query": "label_values(netprobe_probe_success{scope=~\"$scope\"}, name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [],
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "proto",
        "label": "Protocol",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(netprobe_probe_success, proto)",
        "query": {
          "qryType": 1,
          "query": "label_values(netprobe_probe_success, proto)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [],
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Call grade",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Worst score",
      "description": "The lowest mean opinion score across the selected probes. Above 4.0 a call is transparent, below 3.6 callers start asking each other to repeat, below 3.1 the call is not worth having.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "min(netprobe_mos{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"})",
          "legendFormat": "worst MOS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 1,
          "max": 4.5,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#ec835a", "value": 3.1 },
              { "color": "#fab219", "value": 3.6 },
              { "color": "#0ca30c", "value": 4.0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Probes below toll quality",
      "description": "How many probes score under 3.6, the point at which a call stops being comfortable. Zero here and a red round-trip time elsewhere means the latency is real but not yet audible.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(netprobe_mos{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"} < 3.6) or vector(0)",
          "legendFormat": "below 3.6"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 1 },
              { "color": "#d03b3b", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Peak jitter",
      "description": "Highest RFC 3550 interarrival jitter across the selection. This is the deviation from one packet to the next, which is what a jitter buffer has to absorb, and not the spread around the mean that the standard deviation reports.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(netprobe_jitter_seconds{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"})",
          "legendFormat": "peak jitter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 0.02 },
              { "color": "#ec835a", "value": 0.05 },
              { "color": "#d03b3b", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worst R factor",
      "description": "The E-model transmission rating the score is derived from, on a 0 to 100 scale. It moves further than the mean opinion score for the same change and is the better one to alert on.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "min(netprobe_r_factor{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"})",
          "legendFormat": "worst R"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#ec835a", "value": 50 },
              { "color": "#fab219", "value": 70 },
              { "color": "#0ca30c", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Per probe",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Score by probe",
      "description": "Every probe ranked by call quality. A target that scores badly over UDP and well over ICMP is being shaped, not congested.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 11, "w": 10, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sort(netprobe_mos{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"})",
          "instant": true,
          "legendFormat": "{{name}} / {{proto}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 1,
          "max": 4.5,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#ec835a", "value": 3.1 },
              { "color": "#fab219", "value": 3.6 },
              { "color": "#0ca30c", "value": 4.0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16,
        "maxVizHeight": 300
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Score over time",
      "description": "The call grade as it moves. A dip that recovers on its own is congestion in somebody's evening peak; a step that stays down is a routing or capacity change.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 11, "w": 14, "x": 10, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "netprobe_mos{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}",
          "legendFormat": "{{name}} / {{proto}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 1,
          "max": 4.5,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "insertNulls": false,
            "thresholdsStyle": { "mode": "dashed" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "#fab219", "value": 3.6 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "asc", "maxHeight": 600 }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Jitter: RFC 3550 against standard deviation",
      "description": "The two jitter definitions side by side. They disagree on purpose: a path that alternates between two stable latencies has a large standard deviation and a large RFC 3550 jitter, while a path that drifts slowly has the first without the second. The dashed series is the standard deviation.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "netprobe_jitter_seconds{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}",
          "legendFormat": "{{name}} / {{proto}} rfc3550"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "netprobe_rtt_stddev_seconds{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}",
          "legendFormat": "{{name}} / {{proto}} stddev"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "min": 0,
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "insertNulls": false,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*stddev" },
            "properties": [
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc", "maxHeight": 600 }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Latency distribution",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Percentiles over the window",
      "description": "Computed from the per-sample histogram, so these are true quantiles over the rolling window rather than a statistic of the last cycle. The gauges elsewhere cannot answer this: they only ever hold the most recent value, and a 24 hour p99 cannot be recovered from them afterwards.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 11, "w": 14, "x": 0, "y": 29 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(netprobe_sample_rtt_seconds_bucket{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(netprobe_sample_rtt_seconds_bucket{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(netprobe_sample_rtt_seconds_bucket{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__rate_interval])))",
          "legendFormat": "p99"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(netprobe_sample_rtt_seconds_sum{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__rate_interval])) / sum(rate(netprobe_sample_rtt_seconds_count{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__rate_interval]))",
          "legendFormat": "mean"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "min": 0,
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 5,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "insertNulls": false,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "mean" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#898781" } },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc", "maxHeight": 600 }
      }
    },
    {
      "id": 9,
      "type": "heatmap",
      "title": "Where the samples land",
      "description": "Every individual sample, bucketed. A single band is a healthy path; a second band appearing above it is a share of packets taking a different route or waiting in a queue, which an average hides completely.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 11, "w": 10, "x": 14, "y": 29 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (le) (increase(netprobe_sample_rtt_seconds_bucket{name=~\"$target\",proto=~\"$proto\",scope=~\"$scope\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": {} }, "overrides": [] },
      "options": {
        "calculate": false,
        "color": {
          "mode": "scheme",
          "scheme": "Blues",
          "steps": 32,
          "reverse": false,
          "exponent": 0.5,
          "fill": "#3987e5"
        },
        "cellGap": 1,
        "cellValues": { "unit": "short" },
        "yAxis": { "axisPlacement": "left", "unit": "s", "reverse": false },
        "legend": { "show": true },
        "tooltip": { "mode": "single", "yHistogram": true, "showColorScale": true },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "filterValues": { "le": 1e-9 },
        "rowsFrame": { "layout": "auto" },
        "showValue": "never"
      }
    }
  ]
}
